# ============================================================
# LIGA VOLLEY MAHASISWA — Konfigurasi Database & Akses
# Salin file ini menjadi .env.local lalu pilih SALAH SATU backend.
# Prioritas: Supabase (jika terisi) > PostgreSQL lokal.
# ============================================================

# --- OPSI A: PostgreSQL lokal / server mandiri ---
# Contoh lokal Windows (sesuaikan user/password/db):
DATABASE_URL=postgresql://postgres:PASSWORD_ANDA@localhost:5432/liga_volley_mahasiswa
# Alternatif tanpa URL:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=PASSWORD_ANDA
# PGDATABASE=liga_volley_mahasiswa

# --- OPSI B: Supabase cloud ---
# Dari dashboard Supabase -> Project Settings -> API.
# PENTING: SERVICE_ROLE_KEY melewati RLS. Jangan pernah expose ke browser
# (tanpa prefix NEXT_PUBLIC_).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_STORAGE_BUCKET=player-photos # Opsional, default: player-photos

# --- DISPLAY / HOLDING MODE ---
# Tampilkan halaman display production LVM resmi dengan logo lvm.png dan background gradien.
# Nilai: 'true' (aktifkan tampilan display resmi), 'false' (langsung ke portal), atau kosong (otomatis aktif jika NODE_ENV=production).
NEXT_PUBLIC_PRODUCTION_MODE=true

# --- SESI AKSES PORTAL (46 KODE, RBP) ---
# Secret untuk menandatangani cookie sesi login (HMAC-SHA256) dan token
# hapus foto. WAJIB diisi di production; bila kosong saat development,
# server memakai fallback dev (jangan dipakai di production).
# Hasilkan nilai acak, mis. via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_SESSION_SECRET=ganti_dengan_string_acak_minimal_32_karakter

# --- KODE AKSES PERAN (46 KODE) ---
# Kode hardcoded di src/lib/accessCodes.ts (server-only):
#   Panpel    : asp1, asp2, asp3, asp4, asp5            (admin penuh)
#   MojiSport : mojisport1 .. mojisport5               (read-only + laporan)
#   Peserta   : user1 .. user36                        (hanya tim sendiri)
# Tidak ada kredensial lain. ADMIN_SECRET_KEY lama sudah dihapus total.
